# Copie para .env.local e preencha. Nunca versione o .env.local.
# Na Vercel, estas variáveis são definidas no painel do projeto
# (as do Neon vêm da integração; as do Clerk, do painel do Clerk).

# Clerk (Dashboard → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Neon PostgreSQL (integração Vercel → Neon, ou painel do Neon → Connect)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
